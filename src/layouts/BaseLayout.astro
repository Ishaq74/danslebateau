---
import "../styles/styles.css";
import { Font } from "astro:assets";
import Header, { type NavLink } from "../components/Header/Header.astro";
import Footer, { type FooterLink } from "../components/Footer/Footer.astro";
import { Toaster } from "../components/starwind/toast";

interface Props {
  title?: string;
  description?: string;
}
const { title = "Dans le bateau", description = "" } = Astro.props;
const links: NavLink[] = [
  { label: "Accueil", href: "/" },
  {
    label: "Le Livre de Dieu",
    href: "/le-livre-de-dieu",
    children: [
      { label: "La Torah", href: "/le-livre-de-dieu#torah" },
      { label: "L'Évangile", href: "/le-livre-de-dieu#evangile" },
      { label: "Les Psaumes", href: "/le-livre-de-dieu#psaumes" },
      { label: "Job", href: "/le-livre-de-dieu#job" },
      { label: "Jonas", href: "/le-livre-de-dieu#jonas" },
      { label: "Idrîs", href: "/le-livre-de-dieu#idris" },
      { label: "Michaël et les anges", href: "/le-livre-de-dieu#anges" },
    ],
  },
  {
    label: "Les Messagers",
    href: "/messagers",
    children: [
      { label: "Moïse", href: "/messagers#moise" },
      { label: "Adam", href: "/messagers#adam" },
      { label: "David", href: "/messagers#david" },
      { label: "Job", href: "/messagers#job" },
    ],
  },
];
const footerNavLinks: FooterLink[] = [
  { label: "Accueil", href: "/" },
  { label: "Le Livre de Dieu", href: "/le-livre-de-dieu" },
  { label: "Les Messagers", href: "/messagers" },
];
---
<html lang="fr" class="dark">
<head>
  <meta charset="utf-8" />
  <Font cssVariable="--font-barlow" preload />
  <link rel="icon" type="image/svg+xml" href="/logo.svg" />
  <link rel="icon" href="/favicon.ico" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#292929" />
  <meta name="color-scheme" content="dark" />
  <title>{title}</title>
  <meta name="description" content={description} />
</head>
<body class="flex min-h-screen flex-col font-sans antialiased">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-background focus:p-3 focus:text-foreground">Aller au contenu</a>
  <Header siteName="Dans le bateau" links={links} />
  <main id="main-content" class="flex-1">
    <slot />
  </main>
  <Footer
    navLinks={footerNavLinks}
    showNavPrimary={false}
    showNavSecondary={false}
    showLegal={false}
    socialLinks={[
      { name: "TikTok : Sofianemessager", href: "https://www.tiktok.com/@sofianemessager" },
    ]}
    showSocial={true}
    socialHeading="À propos"
    copyrightText="© 2026 - Tous droits réservés"
    message={"Merci d’avoir pris de votre temps pour venir ici, lire, réfléchir, remettre en question, chercher la vérité. À l’heure où tout va vite, où l’on zappe en quelques secondes, le simple fait que vous restiez lire est déjà un cadeau.\n\nMerci pour votre temps, votre attention, votre confiance.\nQue Dieu guide nos cœurs vers ce qui est vrai, nous éloigne de la triche, des mensonges et des illusions, et nous rende capables d’être sincères avec Lui, avec nous-mêmes, et les uns envers les autres.\n\nBienvenue ici. Vous êtes chez vous. L’Éternel sait mieux."}
  />
  <Toaster position="bottom-right" />
</body>
</html>
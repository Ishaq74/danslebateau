---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  tone?: "ink" | "slate" | "graphite" | "wine" | "navy" | "amber" | "umber" | "umber-deep" | "brick" | "none";
  split?: "1/3" | "2/3" | "1/2" | "3/1" | "2/1" | "none";
  as?: "section" | "div" | "article" | "aside";
}

const { tone = "slate", split = "none", as: Tag = "section", class: className, ...rest } = Astro.props;

const tones = {
  ink: "bg-ink", slate: "bg-slate", graphite: "bg-graphite", wine: "bg-wine", navy: "bg-navy",
  amber: "bg-amber-band", umber: "bg-umber", "umber-deep": "bg-umber-deep", brick: "bg-brick", none: "",
} as const;

const splits = {
  none: "",
  "1/3": "md:grid md:grid-cols-[1fr_2fr] md:items-start",
  "2/3": "md:grid md:grid-cols-[2fr_1fr] md:items-start",
  "1/2": "md:grid md:grid-cols-2 md:items-start",
  "3/1": "md:grid md:grid-cols-[3fr_1fr] md:items-start",
  "2/1": "md:grid md:grid-cols-[2fr_1fr] md:items-start",
} as const;
---

<Tag class:list={["prose-band flex flex-col gap-6 rounded-md border p-6 text-parchment shadow-sm md:p-8", tones[tone], splits[split], className]} {...rest}>
  <slot />
</Tag>
---
import { Icon } from "astro-icon/components";
import IconChevronDown from "@tabler/icons/outline/chevron-down.svg";
import type { NavLink } from "./Header.astro";

interface Props {
  links?: NavLink[];
}

const { links = [] } = Astro.props;
---

<nav class="hidden items-center gap-1 @2xl:flex">
  {links.map((link) => (
    link.children && link.children.length > 0 ? (
      <div class="relative group">
        <div class="flex items-center">
          <a href={link.href} class="text-muted-foreground hover:text-foreground rounded-md px-3 py-2 transition-colors">
            {link.label}
          </a>
          <button
            type="button"
            aria-label={`Afficher les rubriques de ${link.label}`}
            class="text-muted-foreground hover:text-foreground rounded-md px-2 py-2 transition-colors"
          >
            <IconChevronDown class="size-4" />
          </button>
        </div>
        <div class="absolute left-0 top-full z-50 hidden min-w-[160px] rounded-md border border-border bg-card shadow-lg group-hover:block group-focus-within:block">
          {link.children.map((child) => (
            <a href={child.href} class="block px-3 py-2 text-sm text-muted-foreground hover:text-foreground hover:bg-muted">
              {child.label}
            </a>
          ))}
        </div>
      </div>
    ) : (
      <a href={link.href} class="text-muted-foreground hover:text-foreground flex items-center gap-1.5 rounded-md px-3 py-2 transition-colors">
        {link.label}
      </a>
    )
  ))}
</nav>
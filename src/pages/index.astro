        <Card class="flex flex-col h-64 relative overflow-hidden" style={`background-image: url(${couv1.src}); background-size: cover; background-position: center;`}>
          <div class="absolute inset-0 bg-black/50"></div>
          <CardHeader class="relative z-10">
            <CardTitle class="text-white">Le Livre de Dieu</CardTitle>
          </CardHeader>
          <CardContent class="flex flex-col flex-1 relative z-10">
            <Button href="/le-livre-de-dieu" variant="outline" class="w-full mt-auto">Lire</Button>
          </CardContent>
        </Card>
        <Card class="flex flex-col h-64 relative overflow-hidden" style={`background-image: url(${couv2.src}); background-size: cover; background-position: center;`}>
          <div class="absolute inset-0 bg-black/50"></div>
          <CardHeader class="relative z-10">
            <CardTitle class="text-white">Les Messagers</CardTitle>
          </CardHeader>
          <CardContent class="flex flex-col flex-1 relative z-10">
            <Button href="/messagers" variant="outline" class="w-full mt-auto">Lire</Button>
          </CardContent>
        </Card>
        <Card class="flex flex-col h-64 relative overflow-hidden" style={`background-image: url(${couv3.src}); background-size: cover; background-position: center;`}>
          <div class="absolute inset-0 bg-black/50"></div>
          <CardHeader class="relative z-10">
            <CardTitle class="text-white">Dans le Bateau</CardTitle>
          </CardHeader>
          <CardContent class="flex flex-col flex-1 relative z-10">
            <Button href="/" variant="outline" class="w-full mt-auto">Lire</Button>
          </CardContent>
        </Card>

---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import Wrapper from '@components/Section/Wrapper.astro';
import HeroSection from '@components/pages/index/sections/HeroSection.astro';
import IntroSection from '@components/pages/index/sections/IntroSection.astro';
import JardinSection from '@components/pages/index/sections/JardinSection.astro';
import SalahuddinSection from '@components/pages/index/sections/SalahuddinSection.astro';
import PardonSection from '@components/pages/index/sections/PardonSection.astro';
import CreationSection from '@components/pages/index/sections/CreationSection.astro';
import QuranSection from '@components/pages/index/sections/QuranSection.astro';
import FourmisSection from '@components/pages/index/sections/FourmisSection.astro';
import MessageSection from '@components/pages/index/sections/MessageSection.astro';
import ArticlesSection from '@components/pages/misc/ArticlesSection.astro';

import bateau from '@assets/images/accueil/bateau-qui-navigue-sur-eau.jpg';
import jardin from '@assets/images/accueil/la-parabole-du-jardin.png';
import tiktok from '@assets/images/accueil/video-tiktok-le-bateauw.jpg';
---

<BaseLayout title="Dans le Bateau" description="Le Bateau, c’est une voie vers Dieu.">
  <Wrapper maxWidth="reading" className="mx-auto space-y-10 py-8">
    <HeroSection image={bateau} alt="Un bateau qui navigue sur une mer agitée" title="Dans le Bateau" />
    <IntroSection />
    <Image src={jardin} alt="La parabole du jardin" class="w-full rounded-lg" />
    <JardinSection />
    <SalahuddinSection />
    <PardonSection />
    <CreationSection />
    <QuranSection />
    <FourmisSection />
    <MessageSection />
    <div class="flex justify-center">
      <Image src={tiktok} alt="Vidéo TikTok" class="w-full max-w-2xl rounded-lg" />
    </div>
    <ArticlesSection />
    <p class="text-sm text-muted-foreground text-center">Je suis pour beaucoup un cas étrange… mais Toi, Tu es mon puissant refuge. (Psaumes 71:7) 🛡️🙏</p>
  </Wrapper>
</BaseLayout>
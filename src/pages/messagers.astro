---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroSection from '@components/pages/messagers/sections/HeroSection.astro';
import IntroSection from '@components/pages/messagers/sections/IntroSection.astro';
import MessagersSection from '@components/pages/messagers/sections/MessagersSection.astro';
import MoiseSection from '@components/pages/messagers/sections/MoiseSection.astro';
import AdamSection from '@components/pages/messagers/sections/AdamSection.astro';
import DavidSection from '@components/pages/messagers/sections/DavidSection.astro';
import JobSection from '@components/pages/messagers/sections/JobSection.astro';
import ArticlesSection from '@components/pages/misc/ArticlesSection.astro';
import { Image } from 'astro:assets';
import sunset from '@assets/images/messagers/coucher-soleil-oiseaux.jpg';
import video from '@assets/images/messagers/file.mp4';
---
<BaseLayout title="Les Messagers" description="Les récits de Moïse, Adam, David et Job dans les Écritures.">
  <div class="mx-auto max-w-reading space-y-10 px-4 py-8">
    <HeroSection title="LES MESSAGERS" />
    <Image src={sunset} alt="Oiseaux en vol au coucher du soleil" class="w-full rounded-lg" />
    <IntroSection />
    <MessagersSection />
    <nav aria-label="Accès direct aux récits" class="flex flex-wrap justify-center gap-3 text-sm">
      <a href="#moise" class="rounded-full border border-primary-accent/50 px-4 py-2 hover:bg-primary-accent/15">Moïse</a>
      <a href="#adam" class="rounded-full border border-primary-accent/50 px-4 py-2 hover:bg-primary-accent/15">Adam</a>
      <a href="#david" class="rounded-full border border-primary-accent/50 px-4 py-2 hover:bg-primary-accent/15">David</a>
      <a href="#job" class="rounded-full border border-primary-accent/50 px-4 py-2 hover:bg-primary-accent/15">Job</a>
    </nav>
    <MoiseSection />
    <AdamSection />
    <DavidSection />
    <JobSection />
    <div class="mx-auto w-full max-w-3xl">
      <video class="w-full rounded-lg" controls preload="metadata" playsinline>
        <source src={video} type="video/mp4" />
        Votre navigateur ne prend pas en charge la lecture vidéo.
      </video>
    </div>
    <ArticlesSection />
  </div>
</BaseLayout>